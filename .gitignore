
# MK Service — .gitignore (monorepo)


# Secrets / env
.env
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
.env.docker
*.pem
*.key

# Versioned templates
!.env.example
!backend/.env.example
!frontend/.env.example

# Python / backend
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
*.whl
venv/
.venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyright/
.cache/
.coverage
coverage.xml
htmlcov/
coverage/
storage/
reports/

# Alembic: compiled only
alembic/**/__pycache__/
alembic/**/*.pyc

# Node / frontend (Next.js)
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
.next/
out/
.npm/
.yarn/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker (local overrides)
docker-compose.override.yml
docker-compose.override.yaml

# Local container data
docker-data/
docker-volume/
docker-cache/
volumes/

# Database / Redis local data
*.sqlite
*.sqlite3
*.db
dump.rdb
*.rdb

# Build / runtime
build/
dist/
*.tsbuildinfo
*.log
*.pid
*.tmp
tmp/
*.orig
*.bak

# Generated report artifacts (NOT the Next.js route)
/reports/
storage/reports/
backend/reports/
*.report.pdf

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo